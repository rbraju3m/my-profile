# Production .env for rashedulraju.dev. Paste into Forge → Site → Environment
# and fill in every <...> value. Never commit the real file.

APP_NAME="Rashedul Raju"
APP_ENV=production
APP_KEY=                                # Forge generates this when the site is created
APP_DEBUG=false
APP_URL=https://rashedulraju.dev
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily files, kept 14 days; warnings and errors only.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# MySQL 8: Forge creates the database and user when you tick "Create database".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rashedulraju
DB_USERNAME=forge
DB_PASSWORD=<from Forge>

# HTTPS-only session cookies (the whole site is HTTPS; .dev requires it).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Full-page cache for public pages (cleared on every admin save and deploy).
RESPONSE_CACHE_ENABLED=true

# SSR server (a Forge daemon). Default port; only reachable from the server itself.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# Email through Resend's SMTP relay. Create an API key at resend.com with
# "Sending access" for the rashedulraju.dev domain only.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=<re_... Resend API key>
MAIL_FROM_ADDRESS="hello@rashedulraju.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact messages are emailed (default: the email in Site settings).
CONTACT_TO=

# Admin: two-factor is required in production. Create the account with
# `php artisan admin:user` (ADMIN_EMAIL/ADMIN_PASSWORD are for local only).
ADMIN_REQUIRE_2FA=true

# Cloudflare Turnstile (contact form spam check). Leave empty until created:
# the form then relies on the honeypot and rate limits.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backups (spatie/laravel-backup), daily at 02:00, 30 days kept.
# Until R2 exists, backups stay on the server only: BACKUP_DISKS=backups
# With R2:                                          BACKUP_DISKS=backups,r2
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=<long random string; store it in your password manager, or backups cannot be opened>
BACKUP_NOTIFY_EMAIL=<your email, for backup failures>

# Cloudflare R2 (S3-compatible). Bucket: rashedulraju-backups, an API token
# with "Object Read & Write" on that bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rashedulraju-backups
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

VITE_APP_NAME="${APP_NAME}"
